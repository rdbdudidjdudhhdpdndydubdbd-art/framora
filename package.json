{
  "name": "framora-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "start:api": "node server/index.js",
    "build": "tsc -b && vite build && node scripts/write-static-photos.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "generate:og": "node scripts/generate-og.mjs",
    "deploy": "BASE_PATH=/<repo>/ npm run build && gh-pages -d dist",
    "test:api": "node scripts/api-smoke-test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "8.0.13"
  }
}
